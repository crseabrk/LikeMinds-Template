{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crseabrk/LikeMinds-Template/schemas/extension-manifest.schema.json",
  "title": "LikeMinds Extension Manifest",
  "type": "object",
  "required": ["extension", "requires", "modifies", "does_not_authorize", "failure_behavior", "uninstall_supported"],
  "properties": {
    "extension": {
      "type": "object",
      "required": ["id", "name", "version", "likeminds_protocol"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "likeminds_protocol": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "required": ["capabilities", "permissions"],
      "properties": {
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "permissions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "modifies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "does_not_authorize": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "failure_behavior": {"enum": ["BLOCKED"]},
    "uninstall_supported": {"const": true},
    "migration_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
